MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=virasatguide

# Generate a private random signing secret; never commit its real value.
JWT_SECRET_KEY=

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Successful Google sign-in returns to this frontend page.
FRONTEND_URL=http://127.0.0.1:5173/src/dashboard/index.html

# Local Ollama model used by stories, tour questions and trip plans.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: disable thinking for supported models such as qwen3:8b.
OLLAMA_THINK=false

# Fish Audio S2.1 Pro Free narration; use your own API key.
FISH_AUDIO_API_KEY=
# Optional Fish Audio voice model ID.
FISH_AUDIO_VOICE_ID=
